   "source": [
    "class Solution:\n",
    "    def createTargetArray(self, nums: List[int], index: List[int]) -> List[int]:\n",
    "        target = []\n",
    "        for idx,num in zip(index,nums):\n",
    "            target.insert(idx,num)\n",
    "        return target\n"
   ]
  }
